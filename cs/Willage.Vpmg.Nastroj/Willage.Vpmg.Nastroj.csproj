<Project Sdk="Microsoft.NET.Sdk">
  <!-- T-1 (N7): samostatný nástroj VPMG nad PŘIPNUTÝM commitem Willage_Dev (net10.0, jen ke čtení, kód Dev se nekopíruje).
       Klient (net9: Willage.Materialy.Api, Godot) s ním mluví mimo proces (JSON řádky, režim server).
       Připnutá kopie: ./priprav_dev.sh → ../../.willage-dev/<commit>/ ; commit = godot-prototyp/data/vpmg/dev_pin.json (test T-1 hlídá shodu). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <RootNamespace>Willage.Vpmg.Nastroj</RootNamespace>
    <WillageDevCommit>12c3e6b05305c9ec6d0c9ed170791643f477871f</WillageDevCommit>
    <WillageDevKoren Condition="'$(WillageDevKoren)' == ''">$(MSBuildThisFileDirectory)../../.willage-dev/$(WillageDevCommit)</WillageDevKoren>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(WillageDevKoren)/src/Modules/World/Willage.World.Materials/Willage.World.Materials.csproj" />
    <ProjectReference Include="$(WillageDevKoren)/src/Modules/World/Willage.World.Vpmg/Willage.World.Vpmg.csproj" />
    <AssemblyMetadata Include="WillageDevCommit" Value="$(WillageDevCommit)" />
    <AssemblyMetadata Include="WillageDevKoren" Value="$([System.IO.Path]::GetFullPath('$(WillageDevKoren)'))" />
  </ItemGroup>
  <Target Name="KontrolaPinuDev" BeforeTargets="CollectPackageReferences;ResolveProjectReferences">
    <Error Condition="!Exists('$(WillageDevKoren)/.pin-ok')" Text="Chybí připnutá kopie Willage_Dev $(WillageDevCommit) v $(WillageDevKoren). Spusť cs/Willage.Vpmg.Nastroj/priprav_dev.sh" />
  </Target>
</Project>
